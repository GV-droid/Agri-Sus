# Agri Sus - local settings
#   1. Copy this file to ".env" in the same folder (the project folder):   cp .env.example .env
#   2. Paste your Gemini API key after GEMINI_API_KEY= (no quotes, no spaces).
#      Get a key at https://aistudio.google.com/apikey
#   3. Restart the server. http://localhost:8080/api/meta then shows "backend": "Gemini API".
#
# The server reads .env when it starts; variables already set in your shell win.
# .env is never committed, uploaded to Cloud Build or copied into the Docker image (with Docker use: --env-file .env).
# Cloud Run does not use it: deploy/deploy.sh connects Gemini through Vertex AI with the site's service account.

GEMINI_API_KEY=

# false = always use the key above, even if GOOGLE_CLOUD_PROJECT is set.
# true  = use Vertex AI in GOOGLE_CLOUD_PROJECT instead (run "gcloud auth application-default login" first).
GOOGLE_GENAI_USE_VERTEXAI=false

# Optional (remove the # to use)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GEMINI_AGENT_MODEL=gemini-3.8-flash
# GEMINI_FORECAST_MODEL=gemini-3.8-flash
